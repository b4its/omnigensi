DATABASE_URL=postgresql+asyncpg://omnigensi:omnigensi_secret@localhost:5558/omnigensi
REDIS_URL=redis://localhost:6505/0
ENCRYPTION_KEY=eGZqX2tFMUdBQ2dMcm1xek1tV2M0X2V2WVBNT2pUZnU4Wms9
WORKSPACE_ROOT=./backend/workspace

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5296,http://localhost:3123,http://127.0.0.1:5296
# Regex allowing phones/tablets on the same LAN (10.x, 192.168.x, 172.16-31.x).
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+)(:\d+)?$

# Absolute base URL reported to clients by GET /api/v1/config.
# Leave empty to auto-detect from the incoming request.
PUBLIC_BASE_URL=

# Frontend build-time API URL. Set to the LAN address (e.g.
# http://192.168.1.10:8123) when opening the UI from a phone or tablet.
PUBLIC_API_URL=http://localhost:8123

# --- Authentication ---
# Single shared operator password protecting the whole instance.
# CHANGE THIS before exposing the app beyond your own machine.
APP_PASSWORD=123
# Set to false only for throwaway local experiments.
AUTH_ENABLED=true
# Secret used to sign session tokens. Leave empty to reuse ENCRYPTION_KEY,
# or set a dedicated random value.
AUTH_TOKEN_SECRET=
# Session lifetime in seconds (default 7 days).
AUTH_TOKEN_TTL_SECONDS=604800
# Mark the session cookie HTTPS-only when serving behind TLS.
AUTH_COOKIE_SECURE=false

# --- Outbound provider requests ---
# TLS verification is ON by default because these calls carry the decrypted
# API key. Only disable it for a self-hosted endpoint with a self-signed cert.
PROVIDER_TLS_VERIFY=true
